# BusinessPulse AI - Environment Configuration
# ===============================================

# Gemini API Key (Required for live AI explanations & briefings)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Set to 1 to force offline deterministic mock mode (no API calls made)
AI_MOCK_MODE=0
